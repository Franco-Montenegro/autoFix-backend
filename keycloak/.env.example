# Copiar este archivo a .env (ignorado por git) y completar los valores.

# Administrador de la consola de Keycloak (http://localhost:8080/admin)
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Contraseñas de los usuarios de prueba del realm autofix:
#   admin -> rol ADMIN
#   user  -> rol USER
AUTOFIX_ADMIN_PASSWORD=
AUTOFIX_USER_PASSWORD=

# Opcional: puerto local de Keycloak (por defecto 8080)
# KEYCLOAK_PORT=8080
