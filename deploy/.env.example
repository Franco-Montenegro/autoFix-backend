# Copiar este archivo a .env (ignorado por git) y completar los valores.
# Evitar comillas simples (') en las contrasenas: las usa el script SQL de inicializacion.

# ---- Imagenes de Docker Hub ----
DOCKERHUB_USERNAME=
# latest o el SHA corto de un commit
IMAGE_TAG=latest

# ---- URL publica (sin "/" final) ----
# PC:  http://localhost        (contexto seguro: el login con PKCE funciona sin HTTPS)
# EC2: https://<subdominio>.duckdns.org
AUTOFIX_PUBLIC_URL=http://localhost

# ---- Entrada publica (nginx-frontend) ----
# PC:  nginx-frontend.http.conf y una carpeta vacia como LETSENCRYPT_DIR (ej. ./letsencrypt)
# EC2: nginx-frontend.conf y /etc/letsencrypt (certificado de certbot con --cert-name autofix)
NGINX_FRONTEND_CONF=nginx-frontend.http.conf
LETSENCRYPT_DIR=./letsencrypt
# Opcional: puertos del host (por defecto 80 y 443). Con AUTOFIX_PUBLIC_URL=http://localhost debe ser 80
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=
# Usuario de la app (base dbautofix)
MYSQL_USER=
MYSQL_PASSWORD=
# Usuario de Keycloak (base keycloak, la crea mysql-init/01-keycloak-db.sh)
KC_DB_USERNAME=
KC_DB_PASSWORD=

# ---- Keycloak ----
# Administrador de la consola (<AUTOFIX_PUBLIC_URL>/auth/admin)
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Contrasenas de los usuarios del realm autofix: admin (rol ADMIN) y user (rol USER)
AUTOFIX_ADMIN_PASSWORD=
AUTOFIX_USER_PASSWORD=
