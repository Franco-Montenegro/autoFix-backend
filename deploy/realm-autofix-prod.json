{
  "realm": "autofix",
  "displayName": "AutoFix",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Acceso a todas las historias de usuario (HU1-HU7)" },
      { "name": "USER", "description": "Acceso a HU1-HU4" }
    ]
  },
  "clients": [
    {
      "clientId": "autofix-frontend",
      "name": "AutoFix Frontend",
      "description": "SPA del taller. Login con la pagina de Keycloak (authorization code + PKCE).",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "${AUTOFIX_PUBLIC_URL}",
      "baseUrl": "/",
      "redirectUris": ["${AUTOFIX_PUBLIC_URL}/*"],
      "webOrigins": ["${AUTOFIX_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${AUTOFIX_PUBLIC_URL}/*"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Admin",
      "lastName": "AutoFix",
      "email": "admin@autofix.local",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "${AUTOFIX_ADMIN_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["ADMIN", "default-roles-autofix"]
    },
    {
      "username": "user",
      "enabled": true,
      "firstName": "Usuario",
      "lastName": "AutoFix",
      "email": "user@autofix.local",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "${AUTOFIX_USER_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["USER", "default-roles-autofix"]
    }
  ]
}
